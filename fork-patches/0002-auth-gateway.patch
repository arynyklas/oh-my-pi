+			return;
+		}
+		if (data === "[") {
+			this.controller.selectPoolMember(this.controller.state.selectedPoolMemberIndex - 1);
+			return;
+		}
+		if (data === "+") {
+			void this.controller.moveSelectedPoolCredential(1);
+			return;
+		}
+		if (data === "-") {
+			void this.controller.moveSelectedPoolCredential(-1);
+		}
+	}
