+			const users = await this.#client.listUsers(signal);
+			if (signal.aborted || this.#closed) return "ready";
+			this.#state.users = { data: users, status: "ready", error: null, stale: false, lastUpdatedAt: nowMs() };
+			this.#state.userDetails = {};
