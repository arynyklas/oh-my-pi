+
+	#mapUserPoolBinding(row: UserPoolBindingRow): AuthGatewayUserPoolBinding {
+		return {
+			poolId: row.pool_id,
+			position: row.position,
+			createdAt: row.created_at,
+			pool: this.#requirePool(row.pool_id),
+		};
