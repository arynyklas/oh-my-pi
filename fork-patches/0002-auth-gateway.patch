+
+function farExpiry(): number {
+	return Date.now() + 60 * 60_000;
+}
+
+function oauthCredential(label: string): AuthCredential {
+	return {
+		type: "oauth",
+		access: label,
+		refresh: `refresh-${label}`,
+		expires: farExpiry(),
+		accountId: `account-${label}`,
+		email: `${label}@example.com`,
+	};
