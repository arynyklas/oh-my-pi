+function captureStdout(): () => string {
+	let captured = "";
+	process.stdout.write = ((chunk: string | Uint8Array): boolean => {
+		captured += typeof chunk === "string" ? chunk : new TextDecoder().decode(chunk);
+		return true;
+	}) as typeof process.stdout.write;
+	return () => captured;
