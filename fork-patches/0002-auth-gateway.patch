+			if (signal.aborted || this.#closed) return "ready";
+			this.#state.pools = { data: pools, status: "ready", error: null, stale: false, lastUpdatedAt: nowMs() };
+			if (credentialsResult.ok) {
+				this.#state.accounts = {
+					data: credentialsResult.credentials,
+					status: "ready",
+					error: null,
+					stale: false,
+					lastUpdatedAt: nowMs(),
