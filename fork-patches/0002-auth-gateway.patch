+	const reader = response.body?.getReader();
+	if (!reader) return "";
+	const decoder = new TextDecoder();
+	let out = "";
+	for (;;) {
+		const { value, done } = await reader.read();
+		if (done) break;
+		out += decoder.decode(value, { stream: true });
+	}
+	return out + decoder.decode();
