+		`Tokens: ${formatNumber(usage.totals.totalTokens)} tokens`,
+		`Cost: ${formatGatewayCost(usage.totals.costUsd)}`,
+	);
+	if (usage.byProviderModel.length > 0) {
+		lines.push("", theme.bold("By model"));
+		for (const row of usage.byProviderModel) {
