+	/** Take the pending fallover notice for `(provider, sessionId)`, if any. Consumes it. */
+	consumeDefaultAccountFallover(provider: string, sessionId: string): DefaultAccountFallover | undefined {
+		const key = `${provider}\0${sessionId}`;
