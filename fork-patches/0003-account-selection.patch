+const SOURCE = "auth-storage-selection-policy-test";
+const CUSTOM_PROVIDER = "unit-selection-policy";
+const HOUR_MS = 60 * 60 * 1000;
+const WEEK_MS = 7 * 24 * HOUR_MS;
+
+function farExpiry(): number {
+	return Date.now() + HOUR_MS;
